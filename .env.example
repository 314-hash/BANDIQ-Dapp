# ==============================================================================
# BANDIQ DePIN Bandwidth Node Agent — Environment Configuration
# ==============================================================================

# Required: Operator EVM wallet address on Sidra Chain (Chain ID: 97453)
# Note: Public address only. NEVER provide your private key or seed phrase.
BANDIQ_OPERATOR_WALLET=0x6d1537bEE4F1EE3f55F4BC9319Aa40252cd39133

# BANDIQ Verification Backend URL (or local mock server: http://127.0.0.1:8080)
BANDIQ_BACKEND_URL=http://127.0.0.1:8080

# Sidra Chain JSON-RPC endpoint
# Public RPC: https://rpc.sidrachain.com
# Local mock: http://127.0.0.1:8080/rpc
BANDIQ_SIDRA_RPC_URL=http://127.0.0.1:8080/rpc

# Local data directory for keys, spool queue, and consent records
BANDIQ_DATA_DIR=.bandiq

# Log level (debug, info, warn, error)
BANDIQ_LOG_LEVEL=info
