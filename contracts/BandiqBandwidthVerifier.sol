pragma solidity ^0.8.20;

/**
 * @title BandiqBandwidthVerifier
 * @notice On-chain cryptographic verifier for BANDIQ Proof-of-Bandwidth vouchers.
 * Validates EIP-712 signatures generated by authorized Verifier daemons,
 * enforces freshness windows, confidence score thresholds, and non-reentrant single-claim nonces.
 */
contract BandiqBandwidthVerifier {
    struct SettlementVoucher {
        bytes32 voucherId;
        string nodeId;
        address beneficiary;
        uint256 verifiedBytes;
        uint256 confidenceScore; // e.g. 985 = 98.5% (scaled by 1000)
        uint256 issuedAt;
        uint256 expiresAt;
        uint256 nonce;
    }

    // EIP-712 Typehashes
    bytes32 public constant EIP712_DOMAIN_TYPEHASH = keccak256(
        "EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"
    );

    bytes32 public constant SETTLEMENT_VOUCHER_TYPEHASH = keccak256(
        "SettlementVoucher(bytes32 voucherId,string nodeId,address beneficiary,uint256 verifiedBytes,uint256 confidenceScore,uint256 issuedAt,uint256 expiresAt,uint256 nonce)"
    );

    bytes32 public immutable DOMAIN_SEPARATOR;
    address public owner;
    uint256 public minConfidenceScore; // 700 = 70.0%

    // Whitelisted verifier daemon addresses
    mapping(address => bool) public authorizedVerifiers;

    // Replay defense: voucherId => redeemed boolean
    mapping(bytes32 => bool) public redeemedVouchers;

    // Node nonce tracking: keccak256(nodeId) => last consumed nonce
    mapping(bytes32 => uint256) public nodeLatestNonce;

    // Events
    event VoucherConsumed(
        bytes32 indexed voucherId,
        bytes32 indexed nodeIdHash,
        string nodeId,
        address indexed beneficiary,
        uint256 verifiedBytes,
        uint256 nonce,
        address verifier
    );

    event VerifierAuthorizationChanged(address indexed verifier, bool authorized);
    event MinConfidenceScoreUpdated(uint256 oldScore, uint256 newScore);
    event OwnershipTransferred(address indexed previousOwner, address indexed newOwner);

    modifier onlyOwner() {
        require(msg.sender == owner, "BandiqBandwidthVerifier: Caller is not owner");
        _;
    }

    constructor(address initialVerifier, uint256 chainId) {
        owner = msg.sender;
        minConfidenceScore = 700; // 70.0%

        DOMAIN_SEPARATOR = keccak256(
            abi.encode(
                EIP712_DOMAIN_TYPEHASH,
                keccak256(bytes("BANDIQ Proof-of-Bandwidth")),
                keccak256(bytes("1")),
                chainId,
                address(this)
            )
        );

        if (initialVerifier != address(0)) {
            authorizedVerifiers[initialVerifier] = true;
            emit VerifierAuthorizationChanged(initialVerifier, true);
        }
        emit OwnershipTransferred(address(0), msg.sender);
    }

    /**
     * @notice Hash a settlement voucher according to EIP-712 standard.
     */
    function hashVoucher(SettlementVoucher calldata voucher) public pure returns (bytes32) {
        return keccak256(
            abi.encode(
                SETTLEMENT_VOUCHER_TYPEHASH,
                voucher.voucherId,
                keccak256(bytes(voucher.nodeId)),
                voucher.beneficiary,
                voucher.verifiedBytes,
                voucher.confidenceScore,
                voucher.issuedAt,
                voucher.expiresAt,
                voucher.nonce
            )
        );
    }

    /**
     * @notice Construct the full EIP-712 digest.
     */
    function getDigest(SettlementVoucher calldata voucher) public view returns (bytes32) {
        return keccak256(
            abi.encodePacked(
                "\x19\x01",
                DOMAIN_SEPARATOR,
                hashVoucher(voucher)
            )
        );
    }

    /**
     * @notice Recover the signer address from an EIP-712 signature.
     */
    function recoverSigner(
        SettlementVoucher calldata voucher,
        bytes calldata signature
    ) public view returns (address) {
        require(signature.length == 65, "BandiqBandwidthVerifier: Invalid signature length");

        bytes32 r;
        bytes32 s;
        uint8 v;

        assembly {
            r := calldataload(signature.offset)
            s := calldataload(add(signature.offset, 32))
            v := byte(0, calldataload(add(signature.offset, 64)))
        }

        if (v < 27) {
            v += 27;
        }
        require(v == 27 || v == 28, "BandiqBandwidthVerifier: Invalid signature v value");

        bytes32 digest = getDigest(voucher);
        return ecrecover(digest, v, r, s);
    }

    /**
     * @notice Verify and immediately consume a Proof-of-Bandwidth voucher.
     * Prevents duplicate redemption and guarantees monotonic nonces.
     */
    function verifyAndConsumeVoucher(
        SettlementVoucher calldata voucher,
        bytes calldata signature
    ) external returns (bool) {
        require(voucher.voucherId != bytes32(0), "BandiqBandwidthVerifier: Invalid voucher ID");
        require(voucher.beneficiary != address(0), "BandiqBandwidthVerifier: Invalid beneficiary");
        require(voucher.verifiedBytes > 0, "BandiqBandwidthVerifier: Zero verified bytes");
        require(!redeemedVouchers[voucher.voucherId], "BandiqBandwidthVerifier: Voucher already redeemed (Replay attack)");
        require(block.timestamp <= voucher.expiresAt, "BandiqBandwidthVerifier: Voucher has expired");
        require(voucher.confidenceScore >= minConfidenceScore, "BandiqBandwidthVerifier: Confidence score below threshold");

        bytes32 nodeHash = keccak256(bytes(voucher.nodeId));
        require(voucher.nonce > nodeLatestNonce[nodeHash], "BandiqBandwidthVerifier: Nonce out of order");

        // Verify cryptographic signature
        address recoveredSigner = recoverSigner(voucher, signature);
        require(recoveredSigner != address(0), "BandiqBandwidthVerifier: Invalid signature recovery");
        require(authorizedVerifiers[recoveredSigner], "BandiqBandwidthVerifier: Signer is not an authorized verifier");

        // Mark as consumed & record monotonic nonce
        redeemedVouchers[voucher.voucherId] = true;
        nodeLatestNonce[nodeHash] = voucher.nonce;

        emit VoucherConsumed(
            voucher.voucherId,
            nodeHash,
            voucher.nodeId,
            voucher.beneficiary,
            voucher.verifiedBytes,
            voucher.nonce,
            recoveredSigner
        );

        return true;
    }

    /**
     * @notice Authorize or revoke an off-chain verifier daemon address.
     */
    function setVerifierAuthorization(address verifier, bool authorized) external onlyOwner {
        require(verifier != address(0), "BandiqBandwidthVerifier: Zero address");
        authorizedVerifiers[verifier] = authorized;
        emit VerifierAuthorizationChanged(verifier, authorized);
    }

    /**
     * @notice Set minimum required statistical confidence score (e.g. 700 = 70.0%).
     */
    function setMinConfidenceScore(uint256 newScore) external onlyOwner {
        require(newScore <= 1000, "BandiqBandwidthVerifier: Max score is 1000");
        uint256 oldScore = minConfidenceScore;
        minConfidenceScore = newScore;
        emit MinConfidenceScoreUpdated(oldScore, newScore);
    }

    /**
     * @notice Transfer contract ownership.
     */
    function transferOwnership(address newOwner) external onlyOwner {
        require(newOwner != address(0), "BandiqBandwidthVerifier: Zero address");
        emit OwnershipTransferred(owner, newOwner);
        owner = newOwner;
    }
}
