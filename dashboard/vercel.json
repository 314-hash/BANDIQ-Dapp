{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "installCommand": "echo 'Static frontend - skipping npm install'",
  "buildCommand": "echo 'BANDIQ DePIN static dashboard ready'",
  "rewrites": [
    {
      "source": "/rpc",
      "destination": "https://node.sidrachain.com"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
